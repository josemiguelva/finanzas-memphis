 "lang": "es",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#f6f7f9",
 "theme_color": "#1f4e78",
 "icons": [
  {
   "src": "icons/v/agenda-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icons/v/agenda-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icons/v/agenda-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./compartir",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "files",
     "accept": [
      "image/*",
      "application/pdf",
      "audio/*",
      "video/*",
      "text/*",
      "*/*"
     ]
    }
   ]
  }
 },
 "id": "./"
}